{
  "name": "partidata",
  "version": "0.1.0",
  "description": "Öppen data om politiska partier i Sverige",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swedev/partidata.git"
  },
  "keywords": [
    "political parties",
    "sweden",
    "open data"
  ],
  "author": "Martin Söderholm",
  "license": "CC0-1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:release": "npm run build && node scripts/build-release.js",
    "build:derived-data": "node scripts/build-derived-data.js",
    "check:derived-data": "node scripts/build-derived-data.js --check",
    "lint": "eslint .",
    "import-val": "node scripts/import-val.js",
    "import-riksdagsval": "node scripts/import-riksdagsval.js",
    "import-partisymboler": "node scripts/import-partisymboler.js",
    "validate:data": "node scripts/validate.js",
    "typecheck": "tsc --noEmit",
    "start": "node .release/server.js",
    "test": "node --test",
    "test:http": "node scripts/http-smoke.js",
    "precommit": "npm run lint && npm run typecheck && npm run check:derived-data && npm run validate:data && npm test && npm run build:release && npm run test:http"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.2",
    "fflate": "^0.8.3",
    "postcss": "^8.5.0",
    "sass": "^1.90.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
