    "precommit": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.0",
    "sass": "^1.90.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
