{
  "name": "partidata",
  "version": "0.1.0",
  "description": "Öppen data om politiska partier i Sverige",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swedev/partidata.git"
  },
  "keywords": [
    "political parties",
    "sweden",
    "open data"
  ],
  "author": "Martin Söderholm",
  "license": "CC0-1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/validate-export.js",
    "lint": "eslint .",
    "import-val": "node scripts/import-val.js",
    "typecheck": "tsc --noEmit",
